{
  "name": "jarvis",
  "version": "0.0.1",
  "private": true,
  "description": "Personal AI operating layer for builders",
  "author": "Benjamin Beguin",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "pkill -f \"code_perso/jarvis/node_modules/electron\" >/dev/null 2>&1; sleep 0.4; exit 0",
    "dev": "sh -c 'ulimit -n 65536 2>/dev/null || ulimit -n 10240 2>/dev/null || ulimit -n 4096 2>/dev/null; echo \"FD limit: $(ulimit -n)\"; electron-vite dev'",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.10",
    "@huggingface/transformers": "^4.2.0",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.3",
    "ffmpeg-static": "^5.2.0",
    "gray-matter": "^4.0.3",
    "keytar": "^7.9.0",
    "nanoid": "^3.3.8",
    "node-cron": "^3.0.3",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "telegraf": "^4.16.3",
    "xstate": "^5.31.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "keytar",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "@img/sharp-darwin-arm64": "0.34.5",
      "@img/sharp-darwin-x64": "0.34.5",
      "@img/sharp-libvips-darwin-arm64": "1.2.4",
      "@img/sharp-libvips-darwin-x64": "1.2.4",
      "sharp": "0.34.5"
    }
  }
}
